  },
  "dependencies": {
    "firebase": "13.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@firebase/rules-unit-testing": "6.0.0"
  }
}
