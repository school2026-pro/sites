// Model: notebooks/{uid}/entries/{id} and notebooks/{uid}/reflections/{YYYY-MM-DD}.
// UID is immutable in the path; no public profile or owner email is stored.
// entries: title string 1..120, notes 0..4000, date YYYY-MM-DD 2000..2100,
// kind task/event, category one of five, priority 1..3, done 0/1,
// start/end nullable HH:mm; deleted bool; version positive int.
// reflections: date as document ID; mood/focus 1..5, minutes 0..1440,
// wins/obstacles/learned string 0..4000, next_action 0..500; version positive int.
// Both: createdAt immutable server timestamp; updatedAt server timestamp.
// Parent notebooks documents intentionally do not exist and are never readable.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAuthenticated(){ return request.auth != null; }
  function isOwner(uid){ return isAuthenticated() && request.auth.uid == uid; }
  function uidUnchanged(){ return !('uid' in request.resource.data); }
  function uidNotModified(){ return !('uid' in request.resource.data); }
  function text(value,min,max){ return value is string && value.size() >= min && value.size() <= max; }
  function date(value){
   return text(value,10,10) && value >= '2000-01-01' && value <= '2100-12-31'
    && value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
  }
  function time(value){ return value == null || (text(value,5,5) && value.matches('([01][0-9]|2[0-3]):[0-5][0-9]')); }
  function meta(d){ return d.createdAt is timestamp && d.updatedAt == request.time && d.version is int && d.version > 0 && d.version <= 2147483647; }
  function isValidEntry(d){
   let keys=['title','kind','date','start','end','category','priority','notes','done','deleted','version','createdAt','updatedAt'];
   return d.keys().hasAll(keys) && d.keys().hasOnly(keys)
    && text(d.title,1,120) && d.title.matches('.*[^\\s].*') && text(d.notes,0,4000)
    && date(d.date) && d.kind in ['task','event'] && d.category in ['学習','学校','部活','生活','その他']
    && d.priority is int && d.priority in [1,2,3] && d.done is int && d.done in [0,1]
    && d.deleted is bool && time(d.start) && time(d.end)
    && (d.end == null || (d.start != null && d.end > d.start))
    && (d.kind != 'event' || d.start == null || d.end != null) && meta(d);
  }
  function isValidReflection(d,id){
   let keys=['date','mood','focus','minutes','wins','obstacles','learned','next_action','version','createdAt','updatedAt'];
   return d.keys().hasAll(keys) && d.keys().hasOnly(keys)
    && date(d.date) && d.date == id
    && d.mood is int && d.mood in [1,2,3,4,5] && d.focus is int && d.focus in [1,2,3,4,5]
    && d.minutes is int && d.minutes >= 0 && d.minutes <= 1440
    && text(d.wins,0,4000) && text(d.obstacles,0,4000) && text(d.learned,0,4000) && text(d.next_action,0,500) && meta(d);
  }
  function fresh(d){ return d.version == 1 && d.createdAt == request.time; }
  function next(d){ return d.createdAt == resource.data.createdAt && d.version == resource.data.version + 1; }
  match /notebooks/{uid}/entries/{id} {
   allow read: if isOwner(uid);
   allow create: if isOwner(uid) && uidUnchanged() && isValidEntry(request.resource.data) && fresh(request.resource.data) && request.resource.data.deleted == false;
   allow update: if isOwner(uid) && uidNotModified() && isValidEntry(request.resource.data) && next(request.resource.data)
    && (resource.data.deleted == false || request.resource.data.deleted == false)
    && (resource.data.deleted == request.resource.data.deleted || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','version','updatedAt']));
   allow delete: if false;
  }
  match /notebooks/{uid}/reflections/{id} {
   allow read: if isOwner(uid);
   allow create: if isOwner(uid) && uidUnchanged() && isValidReflection(request.resource.data,id) && fresh(request.resource.data);
   allow update: if isOwner(uid) && uidNotModified() && isValidReflection(request.resource.data,id) && next(request.resource.data);
   allow delete: if false;
  }
  match /{document=**} { allow read,write: if false; }
 }
}
